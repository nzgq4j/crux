# Crux environment variables — NAMES ONLY.
#
# Never commit a real value to this file.
# Copy to `.env.local` for local development and fill in there; `.env.local` is
# git-ignored. In every other environment, values come from the platform secret store.
#
# Variables prefixed `NEXT_PUBLIC_` are exposed to the browser bundle. Everything else
# is server-side only and must never appear in client code, a client bundle, or a log.
# See `.claude/rules/security.md` and `docs/deployment.md`.

# --- Site -------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=

# --- Supabase ---------------------------------------------------------------
# The publishable key is browser-safe. The secret key is not, under any circumstance.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# --- Transactional email ----------------------------------------------------
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM=

# --- Newsletter -------------------------------------------------------------
NEWSLETTER_PROVIDER=
NEWSLETTER_API_KEY=

# --- Embeddings -------------------------------------------------------------
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=
EMBEDDING_API_KEY=

# --- Analytics and monitoring -----------------------------------------------
ANALYTICS_PROVIDER=
ANALYTICS_SITE_ID=
SENTRY_DSN=

# --- Scheduled jobs and webhooks --------------------------------------------
# Per-environment and rotatable. See docs/security-hardening.md.
CRON_SECRET=
WEBHOOK_SIGNING_SECRET=

# --- Google OAuth (Block 28) ------------------------------------------------
# GOOGLE_OAUTH_CLIENT_SECRET is server-side only and must never be exposed to the
# browser. GOOGLE_OAUTH_REDIRECT_URL must exactly match the environment's public
# origin and be registered with the provider. When
# SUPABASE_AUTH_EXTERNAL_GOOGLE_ENABLED is false, the sign-in control is absent
# rather than present-and-failing.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URL=
SUPABASE_AUTH_EXTERNAL_GOOGLE_ENABLED=
