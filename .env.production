# Public configuration for the deployed preview.
#
# The publishable key is designed to be exposed: it authenticates as the `anon`
# PostgreSQL role and grants nothing that Row Level Security does not already allow
# an anonymous reader. Every view it reads is security_invoker, so the same policies
# that protect the direct-SQL path protect this one. No secret appears here.
NEXT_PUBLIC_SUPABASE_URL=https://jsgawelsrfduyoacdssn.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_paDRSTq3mG-2HIbesGkxxA_YW5HSXAv
NEXT_PUBLIC_SITE_URL=https://crux-crucible.vercel.app
